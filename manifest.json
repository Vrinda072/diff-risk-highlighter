{
  "manifest_version": 3,
  "name": "Diff Risk Highlighter",
  "version": "1.1.0",
  "description": "Flags risky vs. safe-to-skim diff hunks on GitHub pull request pages using static heuristics.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Diff Risk Highlighter \u2014 click to turn highlighting on/off",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/pull/*"
      ],
      "js": [
        "src/risk-engine.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
