{
  "name": "diff-risk-highlighter",
  "version": "1.1.0",
  "private": true,
  "description": "Chrome extension that flags risky vs. safe-to-skim diff hunks on GitHub PR pages.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test -c playwright.browser.config.js",
    "test:e2e": "playwright test",
    "test:e2e:login": "node e2e/save-github-session.js",
    "package": "node scripts/package.js",
    "icons": "node scripts/make-icons.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
